{
  "name": "wx-template",
  "version": "1.0.0",
  "description": "企业级微信小程序空白模板（TypeScript + TDesign，不含业务）",
  "private": true,
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "prepare": "husky",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,json,md,scss,wxml}": "prettier --write",
    "miniprogram/**/*.ts": "eslint --fix --max-warnings 0"
  },
  "keywords": [
    "wechat-miniprogram",
    "typescript",
    "template"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "tdesign-miniprogram": "^1.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tofrankie/prettier-plugin-wxml": "^0.1.0",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "miniprogram-api-typings": "5.2.3",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  }
}
