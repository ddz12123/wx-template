# 实际地址填在 miniprogram/config/env.ts（对照本文件逐项填写）
# develop = 开发者工具预览 / trial = 体验版 / release = 正式版
# 注意：发布渠道不等于后端部署环境，提审前逐个检查。
develop_apiBaseUrl=https://api-dev.example.com
trial_apiBaseUrl=https://api-trial.example.com
release_apiBaseUrl=https://api.example.com

# 后台合法域名（request / uploadFile / downloadFile）：
# https://api-dev.example.com
# https://api-trial.example.com
# https://api.example.com
# 本地调试如需 http://localhost:3000，需在工具中关闭域名校验，仅限开发。
